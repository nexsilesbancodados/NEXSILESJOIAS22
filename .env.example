# =============================================================================
# FRONTEND (build do Vite)
# =============================================================================
# Todas têm padrão embutido em src/lib/config.ts, então o app sobe sem definir
# nenhuma delas. Defina se for apontar para outro projeto Supabase (homologação)
# ou trocar a conta do Mercado Pago.

VITE_SUPABASE_URL=https://your_project_id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key

# Chave PÚBLICA do Mercado Pago da plataforma — usada no checkout da assinatura,
# que é cobrada na conta da Nexsiles. Não é a chave das lojas: a venda de cada
# loja usa a chave que o lojista conecta pelo painel.
VITE_MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# =============================================================================
# EDGE FUNCTIONS (painel do Supabase → Project Settings → Edge Functions → Secrets)
# =============================================================================
# Estas NÃO vão para o .env do frontend. São segredos de servidor e precisam ser
# cadastrados no painel. Sem elas as integrações falham em silêncio.

# --- Mercado Pago ---------------------------------------------------------
# Access token da conta da plataforma (recebe as assinaturas).
MERCADOPAGO_ACCESS_TOKEN=
# Client ID e Secret da aplicação, usados no OAuth que conecta a conta de cada
# lojista. O botão "Conectar Mercado Pago" pede a URL de autorização para a
# função mercadopago-oauth, que monta com o CLIENT_ID daqui.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Assinatura secreta do webhook. Sem ela mercadopago-webhook e ecommerce-webhook
# respondem 500 e nenhuma confirmação de PIX/boleto chega.
MERCADOPAGO_WEBHOOK_SECRET=

# --- E-mail (Brevo) -------------------------------------------------------
BREVO_API_KEY=

# --- WhatsApp (Evolution API) ---------------------------------------------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Segredo que você inventa; precisa ser igual no header x-webhook-token
# configurado na Evolution. Sem ele webhook-whatsapp responde 503.
WHATSAPP_WEBHOOK_SECRET=

# --- Agente de IA ---------------------------------------------------------
DEEPSEEK_API_KEY=

# --- Segredos internos ----------------------------------------------------
# Protege as funções agendadas. As migrations de cron enviam este valor no
# header x-cron-secret — configure aqui e nos jobs ao mesmo tempo.
CRON_SECRET=
# Protege gerar-codigo-acesso e criar-codigo-externo, chamadas pelo site de
# vendas (outro projeto) via header x-cross-secret.
CROSS_PROJECT_SECRET=

# URL pública do app, usada em links de e-mail.
APP_URL=https://nexsiles.com.br
